RewriteEngine On

# No servir configuración ni control de versiones
RewriteRule ^\.env$ - [F,L]
RewriteRule ^\.git - [F,L]

# Código que nunca debe servirse por HTTP (el paquete de producción ya lo excluye)
RewriteRule ^(bin|src|tests|vendor|node_modules)/ - [F,L]
RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml\.dist|AGILE_REPORT\.md|DEPLOY\.md)$ - [F,L]

Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
</IfModule>
