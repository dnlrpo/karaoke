; Configuración de base de datos para Karaoke La Trilla
DB_HOST=localhost
DB_NAME=karaoke
DB_USER=karaoke
DB_PASS=
DB_CHARSET=utf8mb4

; Si la app está detrás de un proxy/CDN, lista de IPs de confianza separadas por comas.
; X-Forwarded-For solo se tiene en cuenta cuando la petición viene de una de ellas.
TRUSTED_PROXIES=
